# Supabase Configuration
# Used for database and storage
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Clerk Configuration
# Authentication and user management
# IMPORTANT: Use LIVE keys (pk_live_...) for plugsy.ng and TEST keys (pk_test_...) for development
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
VITE_CLERK_FRONTEND_API=your_clerk_frontend_api # Fallback if custom domain DNS fails
CLERK_SECRET_KEY=your_clerk_secret_key

# AI Integration
# VITE_GEMINI_API_KEY is used for client-side Gemini AI calls
VITE_GEMINI_API_KEY=
# GEMINI_API_KEY is automatically injected by the platform if available as a secret.
GEMINI_API_KEY=
# OpenAI for additional chatbot capabilities
OPENAI_API_KEY=

# Communications & Payments
# Resend for transactional emails
RESEND_API_KEY=
# Flutterwave for creator monetization and wallet payouts
VITE_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# Cron secret for scheduled tasks
CRON_SECRET=

# Assets & Media
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# App Environment
NEXT_PUBLIC_SITE_URL=https://www.plugsy.ng
# AI Studio automatically injects APP_URL at runtime

# Notifications
VITE_TELEGRAM_ADMIN_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_ADMIN_GROUP_ID=
RESEND_API_KEY=

# Push Notifications (OneSignal)
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_APP_API_KEY=
# Deprecated migration fallback; remove after production verification.
ONESIGNAL_REST_API_KEY=

# Video Calling
DAILY_API_KEY=
